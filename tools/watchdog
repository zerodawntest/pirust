#!/usr/bin/env bash
# watchdog — the second line of defence for the pirust factory (ticket #91), next to keepalive (#86).
# Checks the facts in factory/runtime.md with files, the process table and `hc ls` only, and fixes
# them with plain commands: no pi, no extension, no LLM, no network. One digest line per action
# (AGENTS.md: the digest is the log, a wake-up is a message; nobody waits in the foreground).
#
#   tools/watchdog              check and act — what the systemd user timer runs every 2 min
#   tools/watchdog install      (re-)create that timer: systemd-run --user --on-calendar (no NixOS rebuild)
#   tools/watchdog --dry-run    check and print only; uses test/fixtures/watchdog.env, cases 1-5
#
# 1 t1nm (the lead: the chat with Patrick, and the host of the liaison) is gone: a herdr terminal
#   shows the alert, and the digest gets an ESCALATE line. Only Patrick restarts the lead.
# 2 the driver (pirust-driver) is gone: relaunch it with the Restart line of factory/driver.md, as-is
#   (pi in tools/sandbox, anthropic/claude-opus-5.5 --thinking high, PIRUST_ROLE=driver, --no-session).
# 3 the lead is idle 2 min after a compaction: send it "continue" from factory/STATE.md.
# 4 the driver is idle 15 min while the digest grew since: send it "continue" from factory/driver.md.
# 5 the gh webhook forwarder, or the liaison host, is not running: digest ESCALATE.
# 6 the relaunches use --outlive-parent, so neither the driver nor an agent dies with t1nm.
#
# The state files (the driver's session file, the alert markers) go to a persisted directory:
# /tmp and ~/.cache are wiped on reboot, ~/.pi is not (factory/runtime.md). A --dry-run keeps its
# writes out of the tracked fixtures by pointing the state and digest files at a throwaway dir.

set -uo pipefail
# A failed action is reported and the next check runs: one broken piece must not stop the watchdog.
# (No `set -e`, and `set +e` clears an inherited errexit: the caller's shell options reach us.)
set +e

D=$(dirname "$(readlink -f "$0")")
R=$(dirname "$D")
MODE=run
case "${1:-}" in
  --dry-run) MODE=dry ;;
  install) MODE=install ;;
  "") ;;
  *) printf 'usage: tools/watchdog [--dry-run|install]\n' >&2; exit 2 ;;
esac
shift || true

# The fixtures make cases 1-5 verifiable offline, one file per thing a check reads.
if [ "$MODE" = dry ] && [ -z "${PIRUST_SESSIONS:-}" ]; then
  set -a
  # shellcheck source=/dev/null
  . "$R/test/fixtures/watchdog.env"
  set +a
fi

# The lead's sessions: the lead (t1nm) runs pi in ~/private/pirust. The driver runs it in a
# tools/sandbox with --cwd $R, so its files go in the directory named after $R (factory/runtime.md:
# the relaunch line is the Restart block of factory/driver.md).
SESS=${PIRUST_SESSIONS:-$HOME/.pi/agent/sessions/--home-zerodawn-private-pirust--}
DRIVER_SESS_DIR=${PIRUST_DRIVER_SESS_DIR:-$HOME/.pi/agent/sessions/--${R//\//-}--}
DIGEST=${PIRUST_DIGEST:-$HOME/.pi/pirust-digest.log}
STATE=${PIRUST_STATE:-$HOME/.pi/watchdog}
PROCS=${PIRUST_PROCS:-}
LS_JSON=${PIRUST_LS_JSON:-}
DRIVER_SESS=${PIRUST_DRIVER_SESSION:-}
LEAD=t1nm
DRIVER=pirust-driver
OPUS=${PIRUST_LEAD_MODEL:-anthropic/claude-opus-5.5} # both leads: Opus 5.5 high (factory/design.md)
HC=$(command -v hc 2>/dev/null || true)
[ -x "$HC" ] || HC=

# A dry run must not write into the tracked fixtures (test/fixtures/watchdog-state): its state
# writes go to a throwaway dir, so the next --dry-run starts clean and the diff stays clean. The
# digest file is read (case 4) and written (run mode); in dry mode the writes are prints, so the
# tracked digest fixture stays as it is.
if [ "$MODE" = dry ]; then
  state_scratch=$(mktemp -d "${TMPDIR:-/tmp}/watchdog-dry.XXXXXX")
  STATE=$state_scratch
fi

state_dir=$STATE
mkdir -p "$state_dir" || printf 'watchdog: cannot write %s\n' "$state_dir" >&2

# The process table, read once: one command line per line ($PROCS = a fixture, so cases 1, 2 and 5
# are verifiable offline).
if [ -n "$PROCS" ]; then procs=$(cat "$PROCS" 2>/dev/null); else procs=$(ps -eo args= 2>/dev/null); fi

# run CMD... — run it, or print it (--dry-run: the acceptance check for cases 1-5).
run() {
  local q
  q=$(printf '%q ' "$@")
  q=${q#\'\' } # the lead's and the driver's launches start with hc; a stripped sandbox has none
  if [ "$MODE" = dry ]; then
    printf 'would: %s\n' "$q"
    return 0
  fi
  if "$@" >/dev/null 2>&1; then printf 'did: %s\n' "$q"; else printf 'FAILED: %s\n' "$q" >&2; fi
}

# digest TEXT — one line per action; the lead reads the digest only when it needs to.
digest() {
  local line
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
  if [ "$MODE" = dry ]; then
    printf 'digest: %s\n' "$line"
  else
    printf '%s\n' "$line" >>"$DIGEST"
    printf 'digest: %s\n' "$line"
  fi
}

# n_running RE... — how many process lines match all the REs. A leading `!` on a pattern means it
# must not match. The [p]i bracket keeps this script's own command line, and the grep's, out of the
# matches (the agents' `--thinking low` keeps them out too: only the two leads run Opus high).
n_running() {
  local sel r
  sel=$(printf '%s\n' "$procs" | grep -E -- "${1#!}")
  shift
  for r in "$@"; do
    case $r in
      '!'*) sel=$(printf '%s\n' "$sel" | grep -vE -- "${r#!}") ;;
      *) sel=$(printf '%s\n' "$sel" | grep -E -- "$r") ;;
    esac
  done
  printf '%s\n' "$sel" | grep -c .
}

# last_ts FILE — the newest record timestamp in a session jsonl, as epoch seconds. 0 if unreadable.
last_ts() {
  local t
  t=$(grep -o '"timestamp":"[0-9T:.Z-]*"' "$1" 2>/dev/null | cut -d '"' -f 4 | tail -1)
  [ -n "$t" ] || { printf '0\n'; return; }
  date -d "$t" +%s 2>/dev/null || printf '0\n'
}

# newest FILE... — the newest session file: the name starts with its start time, so the greatest
# name is the newest, whatever the filesystem mtime is (a checkout resets mtimes). Only files that
# exist: an unexpanded glob is one name that is not a file.
newest() {
  local f
  for f in "$@"; do [ -f "$f" ] && printf '%s\n' "$f"; done | sort | tail -1
}

if [ "$MODE" = install ]; then
  # Every 2 min (minutes 0,2,4,... at second 0). The timer is transient, so `install` re-creates it
  # after a reboot; the units systemd-run writes need no daemon-reload and no NixOS rebuild.
  # `--timer` is NOT a systemd-run flag: it is read as an abbreviation of `--timer-property`, so
  # systemd-run refuses with "`--timer-property=` set without any timer trigger expression". The
  # timer expression is `--on-calendar`. The unit runs without the user's env, so pass PATH (and
  # HOME) explicitly: without PATH the `hc` the checks call is not found.
  mkdir -p "$STATE" || { printf 'watchdog: cannot write %s\n' "$STATE" >&2; exit 1; }
  run systemd-run --user --on-calendar='*:0/2' --unit=pirust-watchdog \
    --description='pirust watchdog: restart and wake the lead, the driver, the liaison (ticket #91)' \
    --setenv=PATH="$PATH" --setenv=HOME="$HOME" \
    --collect bash -c "'$D/watchdog' >'$STATE/last-run.log' 2>&1"
  printf 'verify: systemctl --user list-timers | grep pirust-watchdog\n'
  exit 0
fi

# --- 1. t1nm (the lead) is gone: only Patrick restarts it, so alert him.
# Detect both leads by their terminal registrations, not by a model regex: the driver's real launch
# line is `pi --model anthropic/claude-opus-5-5:high -n pirust-driver ...` (the model carries the
# `:high` suffix, so a `--model X --thinking high` regex misses it). `hc ls --json` lists a live
# terminal per record: the lead is addressed `t1nm`, the driver is named `pirust-driver`. A
# sandbox that strips `hc` (the coders run in tools/sandbox) reads a fixture, so cases 1-5 stay
# verifiable offline.
if [ -n "$LS_JSON" ]; then ls=$(cat "$LS_JSON" 2>/dev/null); else ls=$(hc ls --json 2>/dev/null); fi
n_lead=$(printf '%s\n' "$ls" | jq -r '[if type=="array" then .[] else (.terminals // [])[] end | select((.address? // "") == "t1nm")] | length')
n_driver=$(printf '%s\n' "$ls" | jq -r '[if type=="array" then .[] else (.terminals // [])[] end | select((.name? // "") == "pirust-driver")] | length')

if [ "${n_lead:-0}" -lt 1 ]; then
  # An interactive terminal, so Patrick sees it: t1nm is the terminal he talks through, so it is
  # gone as a channel too. The marker caps it at one per hour; a new launch clears it.
  marker=$STATE/alert-t1nm-$(date -u +%Y%m%d%H)
  if [ ! -f "$marker" ]; then
    alert="$LEAD (lead, the chat with Patrick) is gone. Restart it: it is pi on $OPUS, thinking high, cwd $R. The driver was relaunched by tools/watchdog; resume from $R/factory/STATE.md."
    # The launch needs hc; a sandbox that has no hc (the agents' sandbox strips it) still prints it
    # in --dry-run, so the acceptance check for cases 1-5 works there.
    if [ "$MODE" = dry ] || [ -n "$HC" ]; then
      run "$HC" run --name pirust-alert-t1nm --label project=pirust --label role=alert \
        --cwd "$R" bash -c "printf '\\n%s\\n' '$alert'; exec bash"
      digest "ESCALATE $LEAD (lead) gone: herdr alert, restart per $R/factory/roles.md; the driver is relaunched by tools/watchdog"
      touch "$marker"
    fi
  fi
fi

# --- 2. The driver is gone: relaunch it, so the factory keeps driving without a chat session.
if [ "${n_driver:-0}" -lt 1 ]; then
  driver_prompt="Read $R/factory/STATE.md and $R/factory/driver.md, then drive the factory."
  # The launch line is the Restart block of $R/factory/driver.md, as-is: pi in tools/sandbox,
  # anthropic/claude-opus-5.5 --thinking high, PIRUST_ROLE=driver, --no-session, the two -e paths
  # relative (the sandbox binds only $R, and pi resolves -e against the cwd). The relaunch adds
  # --no-parent --outlive-parent, so nothing here dies with t1nm (case 6).
  if [ "$MODE" = dry ] || [ -n "$HC" ]; then
    run "$HC" run --bg --no-notify --no-parent --outlive-parent --name "$DRIVER" \
      --label project=pirust --label role=driver --cwd "$R" \
      env PIRUST_ROLE=driver "$D/sandbox" "$R" pi --mode rpc --no-session -ne \
      -e .pi/extensions/keepalive.ts -e .pi/extensions/ceo-guard.ts \
      --model "$OPUS" --thinking high "$driver_prompt"
    # With --no-session the driver writes no session file at all, so the relaunch time is its
    # "last session write"; the newest file in its own directory is it when it has one.
    printf '%s\n' "$(newest "$DRIVER_SESS_DIR"/*.jsonl)" >"$STATE/driver-session"
    date -u +%s >"$STATE/driver-launch"
  fi
  digest "relaunched $DRIVER: pi $OPUS thinking high in $D/sandbox, no-parent, outlive-parent, prompt $R/factory/driver.md"
fi

# --- 3. The lead is idle 2 min after a compaction: auto-compaction leaves pi idle and nothing
# continues it, so wake it. The driver's own files are in $DRIVER_SESS_DIR, so the newest file
# here is the lead's.
lead_sess=$(newest "$SESS"/*.jsonl)
if [ -n "$lead_sess" ] && [ "${n_lead:-0}" -ge 1 ]; then
  idle=$(( ($(date -u +%s) - $(last_ts "$lead_sess")) / 60 ))
  if [ "$idle" -ge 2 ] && tail -n 1 "$lead_sess" | grep -q '"type":"compaction"'; then
    size=$(wc -c <"$lead_sess")
    marker=$STATE/continued-$(basename "$lead_sess")-$size
    if [ ! -f "$marker" ]; then
      run "$HC" send "$LEAD" "Continue. You were compacted and are idle: resume from $R/factory/STATE.md, keep the factory moving."
      digest "$LEAD idle ${idle}m after a compaction: sent continue from $R/factory/STATE.md"
      touch "$marker"
    fi
  fi
fi

# --- 4. The driver is idle 15 min while the digest grew: events piled up that nobody read.
driver_sess=${DRIVER_SESS:-}
[ -n "$driver_sess" ] || driver_sess=$(newest "$DRIVER_SESS_DIR"/*.jsonl)
[ -n "$driver_sess" ] && [ -f "$driver_sess" ] || driver_sess=$lead_sess
if [ -n "$driver_sess" ] && [ "${n_driver:-0}" -ge 1 ]; then
  sess_ts=$(last_ts "$driver_sess")
  # No session file (relaunch uses --no-session): the relaunch stamp is its last session write.
  if [ "$sess_ts" = 0 ] && [ -f "$STATE/driver-launch" ]; then sess_ts=$(date -r "$STATE/driver-launch" +%s); fi
  idle=$(( ($(date -u +%s) - sess_ts) / 60 ))
  dig_ts=$(date -r "$DIGEST" +%s 2>/dev/null || printf '0')
  if [ "$idle" -ge 15 ] && [ "$dig_ts" -gt "$sess_ts" ]; then
    size=$(wc -c <"$driver_sess")
    # The stamp file keeps its size across relaunches, so the marker carries its mtime too.
    marker=$STATE/continued-$(basename "$driver_sess")-$size-$sess_ts
    if [ ! -f "$marker" ]; then
      run "$HC" send "$DRIVER" "Continue. Read $R/factory/driver.md and keep the factory going: the digest has events since your last message ($DIGEST)."
      digest "$DRIVER idle ${idle}m, digest grew since: sent continue from $R/factory/driver.md"
      touch "$marker"
    fi
  fi
fi

# --- 5. The liaison, or the gh webhook forwarder, is not running: events would reach nobody.
# The liaison runs in the lead (case 1 covers restarting it), the forwarders are plain gh processes.
if [ "${n_lead:-0}" -lt 1 ]; then
  digest "ESCALATE liaison not running: no gh-events host, GitHub events reach nobody (restart $LEAD)"
fi
n_forward=$(n_running '(^|/)gh webhook forward')
if [ "${n_forward:-0}" -lt 2 ]; then
  digest "ESCALATE gh webhook forward not running ($n_forward/2): GitHub events are not pushed; relaunch $LEAD, then $D/agent for the queue"
fi
