#!/usr/bin/env bash
# merge [--dry-run] PR TICKET   Verify a PR, then fast-forward-merge its branch into integration with signed commits.
# Spec: .agents/skills/factory-merge/SKILL.md steps 1-5, one script. Leads run it under `hc run --bg` (factory-bg).
# 1 scope (PR files ⊆ ticket Files:) + PR body has `Verified:`; 2 rebase -S onto integration, run the ticket's Verify
# cmds, all commits signed; 3 ext load-check; 4 gh checks, push t/N + ff integration, ticket Done, close; 5 on any
# failure comment the command+output on the ticket and set Ready. --dry-run runs the checks, skips the writes (step 4).
set -euo pipefail
D=$(dirname "$(readlink -f "$0")"); R=$(dirname "$D"); GH="$D/gh-bot"; TICK="$D/ticket"; B=integration
dr=0; args=()
for x in "$@"; do case $x in --dry-run) dr=1 ;; *) args+=("$x") ;; esac; done
PR=${args[0]:-}; T=${args[1]:-}
[[ $PR =~ ^[0-9]+$ && $T =~ ^[0-9]+$ ]] || { sed -n '2,5p' "$0"; exit 1; }
BR="t/$T"; W="$HOME/.pig/cache/merge-$PR"
report=""; fail=0; out=""; rc=0

# run [-d DIR] DESC CMD... runs CMD (in DIR, else cwd); on non-zero prints `DESC: FAIL`, records cmd+output, sets fail=1.
run(){
  local d=""
  [ "$1" = -d ] && { d=$2; shift 2; }
  local desc=$1; shift
  if [ -n "$d" ]; then out=$(cd "$d" && "$@" 2>&1); rc=$?; else out=$("$@" 2>&1); rc=$?; fi
  local cmd; cmd=$(printf '%q ' "$@")
  if [ $rc -ne 0 ]; then printf '%s: FAIL\n%s\n' "$desc" "$out"; report+=$'\n$ '"$cmd"$'\n'"$out"; fail=1; return 0; fi
  printf '%s: ok\n' "$desc"
}
# note TEXT... appends a plain-text note to the step-5 failure report.
note(){ report+="$*"$'\n'; }

# 1 scope: PR files ⊆ ticket Files:; PR body has `Verified:`.
run "1 pr-view" "$GH" pr view "$PR" --json headRefName,baseRefName,files,body; pjson=$out
run "1 issue-view" "$GH" issue view "$T" --json body; tjson=$out
if [ $fail = 0 ]; then
  head=$(jq -r .headRefName <<<"$pjson"); base=$(jq -r .baseRefName <<<"$pjson")
  [ "$head" = "$BR" ] || { printf '1 scope: FAIL\nhead %s != %s\n' "$head" "$BR"; note "head $head != $BR"; fail=1; }
  [ "$base" = "$B" ] || { printf '1 scope: FAIL\nbase %s != %s\n' "$base" "$B"; note "base $base != $B"; fail=1; }
  grep -q 'Verified:' <<<"$pjson" || { printf '1 scope: FAIL\nPR body has no Verified:\n'; note "PR body has no Verified:"; fail=1; }
  tbody=$(jq -r .body <<<"$tjson")
  files1=$(sed -n '1p' <<<"$tbody")
  case $files1 in
    'Files: '*)
      listed=" ${files1#Files: } "
      for f in $(jq -r '.files[].path' <<<"$pjson"); do
        case $listed in *" $f "*) : ;; *) printf '1 scope: FAIL\n%s out of ticket scope\n' "$f"; note "$f out of ticket scope"; fail=1 ;; esac
      done ;;
    *) printf '1 scope: FAIL\nticket first line is not Files:\n'; note "ticket first line is not Files:"; fail=1 ;;
  esac
  [ $fail = 0 ] && printf '1 scope: ok\n'
fi

# 2 copy under the cache dir, rebase -S onto integration, run the Verify commands, check every commit is signed.
if [ $fail = 0 ]; then
  rm -rf "$W"
  run "2 copy $W" git clone -q "$R" "$W"
  run "2 checkout $BR" git -C "$W" checkout -q -B "$BR" "origin/$BR"
  run "2 fetch origin/$B" git -C "$W" fetch -q origin "$B"
  run "2 rebase -S onto origin/$B" git -C "$W" rebase -q -S "origin/$B"
  if [ $fail = 0 ]; then
    sigs=$(git -C "$W" log --format=%G? "origin/$B..HEAD")
    if printf '%s\n' "$sigs" | grep -qv '^G$'; then
      printf '2 signatures: FAIL\nnot all commits signed (expected all G):\n%s\n' "$sigs"; note "git -C $W log --format=%G? origin/$B: $sigs (all must be G)"; fail=1
    else
      printf '2 signatures: ok\n'
    fi
  fi
  if [ $fail = 0 ]; then
    n=0
    while IFS= read -r line; do
      cmd=${line#- Verify: }; cmd=${cmd%%' -> '*}
      [ -z "$cmd" ] && continue
      run -d "$W" "2 verify: $cmd" bash -c "$cmd"
      n=$((n+1))
    done < <(printf '%s\n' "$tbody" | grep -E '^- Verify: .* -> .*$')
    [ $fail = 0 ] && printf '2 verify commands: ok (%s)\n' "$n"
  fi
fi

# 3 extensions touched: prove each changed .pi/extensions/*.ts loads (pi-extension-check skill).
if [ $fail = 0 ]; then
  exts=$(cd "$W" && git diff --name-only "origin/$B..HEAD" | grep -E '^(\.pi|factory)/extensions/.*\.ts$' | grep -v '\.test\.ts$' || true)
  for f in $exts; do run -d /tmp "3 ext-load $f" bash -c "echo '{\"type\":\"get_state\"}' | timeout 25 pi --mode rpc --no-session -e '$W/$f'"; done
  [ -n "$exts" ] && [ $fail = 0 ] && printf '3 ext-load: ok\n'
fi

# 4 gh checks, push t/N (force) and integration (ff only), ticket Done, close the issue.
if [ $fail = 0 ]; then
  run "4 gh pr checks" "$GH" pr checks "$PR"
  if [ $dr = 1 ]; then
    printf '4 push + tickets: ok (dry-run, writes skipped)\n'
  else
    run "4 push $BR" git -C "$W" push -q -f origin "$BR"
    run -d "$W" "4 merge $B (ff-only)" bash -c "git checkout -q -B $B origin/$B && git merge --ff-only -q $BR"
    run "4 push $B" git -C "$W" push -q origin "$B"
    run "4 ticket set Done" "$TICK" set "$T" -s Done
    run "4 close issue $T" "$GH" issue close "$T" -b "Merged via PR #$PR (integration $(cd "$W" && git rev-parse --short HEAD))."
    [ $fail = 0 ] && printf '4 push + tickets: ok\n'
  fi
fi

# 5 any step failed: comment the command+output on the ticket, set Ready.
if [ $fail = 1 ]; then
  [ $dr = 0 ] && { $GH issue comment "$T" -b "merge refused (report):$report" >/dev/null; $TICK set "$T" -s Ready >/dev/null; }
  exit 1
fi
