#!/usr/bin/env bash
# sandbox WORKTREE CMD...  Run CMD with only WORKTREE (+ cargo cache) writable.
# No ~/.ssh, ~/.config (gh/git), keyring, .git, GitHub/hc env. Network shared (model gateway).
set -euo pipefail
R=$(dirname "$(dirname "$(readlink -f "$0")")")
W=$(readlink -f "$1"); shift
H=$HOME; S=$H/.pig/sandbox; A=$S/agent
mkdir -p "$S/cargo" "$A/sessions"; touch "$A/models.json"
[ -f "$A/settings.json" ] || jq '{defaultProvider:"ibm-next",defaultModel:"qwen38-flash-next",enableAnalytics:false,enableInstallTelemetry:false,hideThinkingBlock:true}' "$H/.pig/agent/settings.json" > "$A/settings.json"
if ! command -v cargo >/dev/null || ! command -v bwrap >/dev/null; then eval "$(cd "$R" && devenv print-dev-env)"; fi
args=(
  --unshare-all --share-net --die-with-parent
  --ro-bind /nix /nix --ro-bind /etc /etc --ro-bind /run/current-system /run/current-system
  --ro-bind-try /bin /bin --ro-bind-try /usr /usr
  --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run/user
  --tmpfs "$H"
  --bind "$A" "$H/.pig/agent" --ro-bind "$H/.pig/agent/models.json" "$H/.pig/agent/models.json"
  --bind "$S/cargo" "$H/.cargo"
  --ro-bind /run/agenix/gateway_key_pi /run/agenix/gateway_key_pi
  --ro-bind /run/agenix/ibm_next_api_key /run/agenix/ibm_next_api_key
  --bind "$W" "$W" --ro-bind /dev/null "$W/.git" --chdir "$W"
  --setenv HOME "$H" --setenv CARGO_HOME "$H/.cargo" --setenv PIG_CODING_AGENT_DIR "$H/.pig/agent"
)
for v in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN SSH_AUTH_SOCK GPG_AGENT_INFO DBUS_SESSION_BUS_ADDRESS XDG_RUNTIME_DIR HC_TERMINAL_ID HC_TERMINAL_SOCKET HC_SCOPE GIT_CONFIG_COUNT; do args+=(--unsetenv "$v"); done
exec bwrap "${args[@]}" "$@"
