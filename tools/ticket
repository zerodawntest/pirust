#!/usr/bin/env bash
# ticket new  -t TITLE -k Epic|Feature|Task|Bug [-p PARENT#] [-l lab1,lab2] [-s Status] [-P P1] [-S M] [-b BODY|-]
# ticket set  NUM [-s Status] [-P P1] [-S M] [-c CLAIM]
# Prints issue number. Repo is fixed: zerodawntest/pirust.
# shellcheck disable=SC2016  # GraphQL $vars are literal in the query string; bound via -f
set -euo pipefail
D=$(dirname "$(readlink -f "$0")"); B=$D/board.json; R=zerodawntest/pirust; PROJ=$(jq -r .project "$B")
fid(){ jq -r --arg f "$1" '.fields[$f].id' "$B"; }
oid(){ jq -r --arg f "$1" --arg o "$2" '.fields[$f].options[$o] // error("bad \($f): \($o)")' "$B"; }
valid(){ jq -e --arg f "$1" --arg o "$2" '.fields[$f].options[$o] != null' "$B" >/dev/null; }
usage(){ sed -n '2,4p' "$0"; exit 1; }
die(){ printf 'ticket: %s\n' "$*" >&2; exit 1; }
# Values go via -f variables, never interpolated into the query string: a value
# containing `"` (e.g. an issue body with JSON) would break the query otherwise (#81).
# shellcheck disable=SC2016  # GraphQL $vars are literal in the query string; bound via -f
setsel(){ gh api graphql -f 'query=mutation($iid:ID!,$fid:ID!,$sid:String!){ updateProjectV2ItemFieldValue(input:{projectId:"'"$PROJ"'", itemId:$iid, fieldId:$fid, value:{singleSelectOptionId:$sid}}){ clientMutationId }}' -f iid="$1" -f fid="$(fid "$2")" -f sid="$(oid "$2" "$3")" >/dev/null; }
settxt(){ gh api graphql -f 'query=mutation($iid:ID!,$fid:ID!,$txt:String!){ updateProjectV2ItemFieldValue(input:{projectId:"'"$PROJ"'", itemId:$iid, fieldId:$fid, value:{text:$txt}}){ clientMutationId }}' -f iid="$1" -f fid="$(fid "$2")" -f txt="$3" >/dev/null; }
# item NUM [NID] -> project item id (adds if missing). NID comes from the create
# response: refetching right after creation can return an error body, which then breaks
# the GraphQL query string (ticket #44). Falls back to a fetch for `set`.
item(){
  local n=$1 nid=${2:-}
  [ -n "$nid" ] || nid=$(gh api "repos/$R/issues/$n" --jq '.node_id // empty')
  [[ $nid =~ ^I_[A-Za-z0-9_-]+$ ]] || die "issue $n: invalid node_id '$nid'"
  local q='mutation($pid:ID!,$cid:ID!){ addProjectV2ItemById(input:{projectId:$pid, contentId:$cid}){ item{ id } }}'
  # Capture each attempt's stdout separately; on retry the first attempt's error output
  # must NOT leak into the returned item id (that made it multi-line and broke setsel).
  local r
  if ! r=$(gh api graphql -f query="$q" -f pid="$PROJ" -f cid="$nid" --jq .data.addProjectV2ItemById.item.id 2>/dev/null); then
    sleep 2
    r=$(gh api graphql -f query="$q" -f pid="$PROJ" -f cid="$nid" --jq .data.addProjectV2ItemById.item.id)
  fi
  printf '%s' "$r"
}
# Lint a ticket body (ticket #139). Prints one line per problem; returns 1 if any.
lint(){
  local body=$1
  local -a probs=()
  local first
  first=$(printf '%s\n' "$body" | sed -n '1p')
  # Rule: the body's first line must start with Files:
  [ "${first#Files:}" != "$first" ] || probs+=("no Files: line")
  # Rule: Files: lists at most 3 paths (comma-separated).
  if [ "${first#Files:}" != "$first" ]; then
    local count
    count=$(printf '%s' "${first#Files:}" | tr ',' '\n' | grep -c '[^[:space:]]')
    [ "$count" -le 3 ] || probs+=("Files: lists more than 3 paths ($count)")
  fi
  # Rule: a ## Done when section with at least one line starting with "- Verify:".
  printf '%s\n' "$body" | awk '/^##[[:space:]]/{ins=($0 ~ /^##[[:space:]]+Done when[[:space:]]*$/)} ins&&/^- Verify:/{f=1} END{exit !f}' || probs+=("no Verify line")
  # Rule: the body has at most 45 lines.
  local lines
  lines=$(printf '%s\n' "$body" | wc -l)
  [ "$lines" -le 45 ] || probs+=("body has more than 45 lines ($lines)")
  # Rule: no reference to a factory/*.md path, and no use of the word "skill".
  printf '%s' "$body" | grep -Eq 'factory/[^[:space:]]*\.md' && probs+=("references a factory .md path")
  printf '%s' "$body" | grep -Eqw 'skill' && probs+=("references a skill")
  if [ ${#probs[@]} -gt 0 ]; then
    printf '%s\n' "${probs[@]}"
    return 1
  fi
}
cmd=${1:-}; shift || true
case $cmd in
new)
  GH_TOKEN=$("$D/gh-app-token"); export GH_TOKEN
  T='' K=Task P='' L='' S=Backlog PR='' SZ='' BODY=''
  while getopts t:k:p:l:s:P:S:b: o; do case $o in t)T=$OPTARG;; k)K=$OPTARG;; p)P=$OPTARG;; l)L=$OPTARG;; s)S=$OPTARG;; P)PR=$OPTARG;; S)SZ=$OPTARG;; b)BODY=$OPTARG;; *)usage;; esac; done
  [ "$BODY" = - ] && BODY=$(cat); BODY=$(printf '%b' "$BODY")
  TYPE=$K; [ "$K" = Epic ] && { TYPE=; L=${L:+$L,}epic; }
  args=(-f title="$T" -f body="$BODY"); [ -n "$TYPE" ] && args+=(-f type="$TYPE")
  for l in ${L//,/ }; do args+=(-f "labels[]=$l"); done
  # Validate -k/-s/-P/-S against board.json before creating, so a bad value cannot create an issue with an unset field (see #27).
  { [ "$K" = Epic ] || [ "$K" = Feature ] || [ "$K" = Task ] || [ "$K" = Bug ]; } || usage
  { [ -z "$S" ] || valid Status "$S"; } || usage
  { [ -z "$PR" ] || valid Priority "$PR"; } || usage
  { [ -z "$SZ" ] || valid Size "$SZ"; } || usage
  # Lint is enforced on `set ... -s Ready` (an agent must not be launched on a bad
  # ticket); `new` must always create + set fields and exit 0, so it does not gate here.
  J=$(gh api "repos/$R/issues" "${args[@]}"); N=$(jq -r .number <<<"$J"); ID=$(jq -r .id <<<"$J")
  [[ ,$L, == *,needs:patrick,* ]] && gh api "repos/$R/issues/$N/assignees" -f "assignees[]=Patrick-Kappen" -f "assignees[]=Patrick-Kappen-SLTN" >/dev/null
  [ -n "$P" ] && gh api "repos/$R/issues/$P/sub_issues" -F sub_issue_id="$ID" >/dev/null
  NID=$(jq -r '.node_id // empty' <<<"$J")
  { [ -n "$N" ] && [ "$N" != null ]; } || die "new: no issue number in the create response: $J"
  [ -n "$NID" ] || die "new: no node_id in the create response for issue $N"
  I=$(item "$N" "$NID"); setsel "$I" Status "$S"; [ -n "$PR" ] && setsel "$I" Priority "$PR"; [ -n "$SZ" ] && setsel "$I" Size "$SZ"
  echo "$N" ;;
set)
  GH_TOKEN=$("$D/gh-app-token"); export GH_TOKEN
  N=$1; shift
  S='' PR='' SZ='' CL='' CLSET=0
  while getopts s:P:S:c: o; do case $o in s)S=$OPTARG;; P)PR=$OPTARG;; S)SZ=$OPTARG;; c)CL=$OPTARG; CLSET=1;; *)usage;; esac; done
  # Lint before any GitHub write: an agent must not be launched on a bad ticket.
  if [ "$S" = Ready ]; then
    issue=$("$D/gh-bot" api "repos/$R/issues/$N")
    kind=$(jq -r '.type.name // ""' <<<"$issue")
    if [ "$kind" = Task ] || [ "$kind" = Bug ]; then
      lint "$(jq -r '.body // ""' <<<"$issue")" || exit 1
    fi
  fi
  I=$(item "$N")
  [ -n "$S" ] && setsel "$I" Status "$S"
  [ -n "$PR" ] && setsel "$I" Priority "$PR"
  [ -n "$SZ" ] && setsel "$I" Size "$SZ"
  # Track -c separately from its value so `-c ""` clears Claimed by, and end with an
  # explicit exit 0 so a not-given flag does not leave the arm returning 1 under set -e.
  [ "$CLSET" = 1 ] && settxt "$I" "Claimed by" "$CL"
  exit 0 ;;
lint)
  [ $# -eq 1 ] || usage
  lint "$(cat "$1")" ;;
*) usage ;;
esac
